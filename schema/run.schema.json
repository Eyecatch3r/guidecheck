{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guidecheck run",
  "description": "Result of one update assessment of one guide. Written by the agent, read by the review interface.",
  "type": "object",
  "required": [
    "schemaVersion",
    "guide",
    "runId",
    "createdAt",
    "agent",
    "verdict",
    "revisionLevel",
    "summary",
    "changes",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "description": "Write 2. In version 1 every change is a comment: 'rationale' is its text and 'proposed' its suggested wording."
    },
    "guide": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Folder name in guides/."
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "Folder name in runs/<guide>/. Use YYYY-MM-DD-<agent>."
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "agent": {
      "type": "string",
      "description": "Tool and model, for example 'Claude Code (claude-opus-5-5)'."
    },
    "prompt": {
      "type": "string",
      "description": "Path of the prompt file that the agent used."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True only for demo data."
    },
    "verdict": {
      "enum": [
        "current",
        "minor",
        "substantive",
        "structural",
        "superseded"
      ]
    },
    "revisionLevel": {
      "enum": [
        "reference",
        "substantive",
        "structural",
        "conceptual"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Two to four sentences."
    },
    "timeliness": {
      "type": "array",
      "description": "Part 3, dimensions A to H.",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "rating",
          "note"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "rating": {
            "enum": [
              "current",
              "partly",
              "outdated",
              "n/a"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "developments": {
      "type": "array",
      "description": "Part 8, ranked by importance.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "significance"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "significance": {
            "$ref": "#/$defs/significance"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "retain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parts that do not need to change."
    },
    "changes": {
      "type": "array",
      "description": "Version 2. Version 1 items have no 'type' and are read as comments.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "section",
          "title",
          "original"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "type": {
            "enum": [
              "comment",
              "correction"
            ],
            "description": "comment: a finding anchored to a passage, like a Word comment. The text of the guide does not change. correction: an error of form (typo, spelling, grammar, punctuation) that is fixed in the text without an editorial comment."
          },
          "section": {
            "type": "string",
            "description": "Heading of the section in the guide."
          },
          "title": {
            "type": "string",
            "description": "Short label, maximum 60 characters."
          },
          "kind": {
            "enum": [
              "revise",
              "add",
              "remove",
              "reference"
            ],
            "description": "Comments only: what the comment asks the editor to do."
          },
          "significance": {
            "$ref": "#/$defs/significance"
          },
          "direction": {
            "enum": [
              "confirms",
              "extends",
              "qualifies",
              "contradicts",
              "supersedes"
            ]
          },
          "priority": {
            "enum": [
              "essential",
              "important",
              "optional"
            ]
          },
          "original": {
            "type": "string",
            "minLength": 1,
            "description": "Exact passage from original.md. Must occur exactly one time. For a comment, this is the anchor: the shortest passage the comment refers to. For a correction, this is the text to replace."
          },
          "comment": {
            "type": "string",
            "description": "Comment text: the finding, why it matters, and what the editor should check. Refer to sources as s1, s2."
          },
          "suggestion": {
            "type": "string",
            "description": "Optional replacement wording for the anchor. The editor can copy it into Word. It is not applied to the guide."
          },
          "proposed": {
            "type": "string",
            "description": "Corrections only: the corrected text for 'original'."
          },
          "rationale": {
            "type": "string",
            "description": "Corrections: optional one-line reason. Version 1 comments: the comment text."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "comment"
                }
              }
            },
            "then": {
              "required": [
                "comment",
                "significance",
                "direction",
                "priority",
                "sources"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "correction"
                }
              }
            },
            "then": {
              "required": [
                "proposed"
              ]
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "citation",
          "type",
          "verified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "citation": {
            "type": "string",
            "description": "Full citation, APA 7."
          },
          "year": {
            "type": "integer"
          },
          "venue": {
            "type": "string"
          },
          "doi": {
            "type": "string",
            "description": "DOI without the https://doi.org/ prefix."
          },
          "url": {
            "type": "string"
          },
          "type": {
            "enum": [
              "peer-reviewed",
              "preprint",
              "book",
              "report",
              "standard",
              "regulation",
              "editorial",
              "other"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "verificationNote": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "relevance": {
            "type": "string"
          }
        }
      }
    },
    "search": {
      "type": "object",
      "description": "Part 7.",
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dateRange": {
          "type": "string"
        },
        "inclusion": {
          "type": "string"
        },
        "exclusion": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "significance": {
      "enum": [
        "major",
        "significant",
        "relevant",
        "incremental"
      ]
    }
  }
}
